FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/workspace/ugas/src

RUN apt-get update \
    && apt-get install --no-install-recommends -y git ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 ugas \
    && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin ugas

WORKDIR /opt/ugas
COPY pyproject.toml README.md LICENSE ./
COPY src ./src
COPY schemas ./schemas
COPY docs ./docs
COPY CHECKPOINT.md INSTALL.md ./

RUN python -m pip install --no-cache-dir .

WORKDIR /workspace/ugas
RUN git config --system --add safe.directory /workspace/ugas
USER 10001:10001

HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=5 \
    CMD python -c "from urllib.request import urlopen; response=urlopen('http://127.0.0.1:8765/api/health', timeout=2); raise SystemExit(0 if response.status == 200 else 1)"

ENTRYPOINT ["python", "-m", "ugas.cli", "dashboard", "--host", "0.0.0.0", "--port", "8765", "--no-open"]
