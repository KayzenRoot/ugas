{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ugas.local/schemas/engineering-correction-delta.schema.json",
  "title": "UGAS Engineering Correction Delta",
  "type": "object",
  "required": ["correction_delta_id", "work_order_id", "status", "trigger", "root_cause", "changed_paths", "validation", "rollback"],
  "properties": {
    "correction_delta_id": {"type": "string"},
    "work_order_id": {"type": "string"},
    "status": {"enum": ["NOT_APPLICABLE", "PROPOSED", "IMPLEMENTED", "BLOCKED"]},
    "trigger": {"type": "string"},
    "root_cause": {"type": "string"},
    "changed_paths": {"type": "array", "items": {"type": "string"}},
    "validation": {"type": "array", "items": {"type": "string"}},
    "rollback": {"type": "string"}
  },
  "additionalProperties": true
}
