{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ugas.local/schemas/engineering-evidence-bundle.schema.json",
  "title": "UGAS Engineering Evidence Bundle",
  "type": "object",
  "required": ["work_order_id", "repository", "baseline_sha", "branch", "status", "validations", "artifacts", "external_review"],
  "properties": {
    "work_order_id": {"type": "string"},
    "repository": {"type": "string"},
    "baseline_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "branch": {"type": "string"},
    "status": {"enum": ["DRAFT", "READY_FOR_REVIEW", "BLOCKED", "COMPLETE"]},
    "validations": {"type": "array", "minItems": 1},
    "artifacts": {"type": "array", "minItems": 1},
    "external_review": {"type": "object", "required": ["status"], "properties": {"status": {"enum": ["NOT_CLAIMED", "REQUIRED", "APPROVED"]}}}
  },
  "additionalProperties": true
}
