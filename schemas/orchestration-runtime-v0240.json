{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ugas.dev/schema/orchestration-runtime-v0240.json",
  "title": "UGAS orchestration runtime v0.24.0",
  "type": "object",
  "required": ["schema_version", "request", "dag", "snapshot", "gates", "negative_controls", "production"],
  "properties": {
    "schema_version": {"const": "0.24.0"},
    "request": {"$ref": "#/$defs/request"},
    "dag": {"$ref": "#/$defs/dag"},
    "snapshot": {"type": "object", "required": ["request_hash", "dag_hash", "states", "events", "provider_submit_calls", "test_only"], "properties": {"request_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "dag_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "states": {"type": "object"}, "events": {"type": "array"}, "provider_submit_calls": {"const": 0}, "test_only": {"const": true}}},
    "gates": {"type": "object", "required": ["gates", "overall_pass"], "properties": {"gates": {"type": "object", "minProperties": 30}, "overall_pass": {"const": true}}},
    "negative_controls": {"type": "object", "required": ["controls", "status"], "properties": {"controls": {"type": "object", "minProperties": 30}, "status": {"const": "PASS"}}},
    "production": {"type": "object", "required": ["production_routing", "production_approved", "real_asset_generation", "new_generation", "synthetic_fixture"], "properties": {"production_routing": {"const": "BLOCKED"}, "production_approved": {"const": false}, "real_asset_generation": {"const": "NONE"}, "new_generation": {"const": 0}, "synthetic_fixture": {"const": "TEST_ONLY"}}}
  },
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "request_id", "project_id", "request_kind", "asset_family", "operation", "inputs", "dependency_refs", "outputs", "quality_profile", "budget_profile", "priority", "timeout_seconds", "retry_policy", "idempotency_key", "production_intent", "test_only", "request_hash"],
      "properties": {
        "schema_version": {"const": "0.24.0"}, "request_id": {"type": "string", "minLength": 1}, "project_id": {"type": "string", "minLength": 1}, "request_kind": {"const": "ASSET_OPERATION"}, "asset_family": {"enum": ["equipment_outfits", "creatures_monsters", "items_props", "environment_tilesets", "maps_minimap", "ui_asset_family", "vfx_asset_family"]}, "operation": {"enum": ["VALIDATE", "EXECUTE", "RESUME"]}, "inputs": {"type": "object"}, "dependency_refs": {"type": "array"}, "outputs": {"type": "object"}, "quality_profile": {"type": "string"}, "budget_profile": {"type": "string"}, "priority": {"type": "integer", "minimum": 0, "maximum": 100}, "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}, "retry_policy": {"type": "object", "additionalProperties": false, "required": ["max_attempts", "retryable_errors"], "properties": {"max_attempts": {"type": "integer", "minimum": 1, "maximum": 3}, "retryable_errors": {"type": "array", "items": {"type": "string"}}}}, "idempotency_key": {"type": "string", "minLength": 1}, "production_intent": {"const": false}, "test_only": {"const": true}, "request_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "node": {"type": "object", "additionalProperties": false, "required": ["node_id", "dependencies", "operation", "input_contract_hash", "dependency_hashes", "timeout_seconds", "retry_policy", "resource_class", "scheduling_key", "priority", "asset_family"], "properties": {"node_id": {"type": "string", "minLength": 1}, "dependencies": {"type": "array", "items": {"type": "string"}}, "operation": {"type": "string"}, "input_contract_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "dependency_hashes": {"type": "object"}, "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}, "retry_policy": {"type": "object"}, "resource_class": {"type": "string"}, "scheduling_key": {"type": "string"}, "priority": {"type": "integer", "minimum": 0, "maximum": 100}, "asset_family": {"type": "string"}}},
    "dag": {"type": "object", "additionalProperties": false, "required": ["schema_version", "dag_id", "project_id", "request_hash", "nodes", "dag_hash"], "properties": {"schema_version": {"const": "0.24.0"}, "dag_id": {"type": "string"}, "project_id": {"type": "string"}, "request_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "nodes": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/node"}}, "dag_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
  }
}
