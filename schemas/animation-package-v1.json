{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ugas.local/schemas/animation-package-v1.json",
  "title": "UGAS animation package v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "animation_id", "direction", "frame_count", "fps", "per_frame_duration_ms", "loop", "format", "cell_size", "sheet_size", "sprite_sheet", "metadata", "preview_gif", "registry_state", "production_approved"],
  "properties": {
    "schema_version": {"const": "animation-package-1.0"},
    "package_id": {"type": "string"},
    "animation_id": {"type": "string"},
    "direction": {"type": "string"},
    "frame_count": {"type": "integer", "minimum": 2, "maximum": 64},
    "fps": {"type": "number", "exclusiveMinimum": 0},
    "per_frame_duration_ms": {"type": "number", "exclusiveMinimum": 0},
    "loop": {"type": "boolean"},
    "event_markers": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["event_id", "frame", "kind"], "properties": {"event_id": {"type": "string", "minLength": 1}, "frame": {"type": "integer", "minimum": 0}, "kind": {"type": "string", "minLength": 1}, "payload": {"type": "object"}}}},
    "event_markers_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "format": {"const": "RGBA"},
    "cell_size": {"type": "object", "required": ["width", "height"], "properties": {"width": {"type": "integer"}, "height": {"type": "integer"}}},
    "sheet_size": {"type": "object", "required": ["width", "height"], "properties": {"width": {"type": "integer"}, "height": {"type": "integer"}}},
    "sprite_sheet": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "metadata": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "preview_gif": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "registry_state": {"const": "pilot/technical-qualified"},
    "production_approved": {"const": false},
    "production_routing": {"const": "BLOCKED"},
    "qa_status": {"type": "string"}, "qa_decision": {"enum": ["QUALIFIED", "FAILED"]},
    "adapter_metadata": {"type": "object"},
    "source_rig_revision": {"type": "string"},
    "source_rig_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "r4_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
