{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ugas.dev/schema/asset-revision.json",
  "title": "UGAS asset revision and quality gate",
  "type": "object",
  "required": ["schema_version", "revision_id", "asset_id", "revision_number", "derived_from", "output_path", "output_sha256", "technical_status", "transparency_status", "state", "visual_approval", "production_ready"],
  "properties": {
    "schema_version": {"type": "string"}, "revision_id": {"type": "string"}, "asset_id": {"type": "string"}, "revision_number": {"type": "integer", "minimum": 1}, "derived_from": {"type": ["object", "null"]}, "output_path": {"type": "string"}, "output_sha256": {"type": "string"}, "technical_status": {"enum": ["TECHNICAL_VALID", "failed"]}, "transparency_status": {"enum": ["TRANSPARENCY_VALID", "not-required", "failed"]}, "state": {"enum": ["GENERATED", "TECHNICAL_VALID", "TRANSPARENCY_VALID", "VISUAL_REVIEW_REQUIRED", "VISUALLY_APPROVED", "PRODUCTION_READY"]}, "visual_approval": {"type": "object"}, "production_ready": {"type": "boolean"}
  }
}
