{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UGAS v0.18.2 derived variant and state contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_type", "production_registry", "registry_authority", "production_routing", "canonical_directions", "canonical_animation_states", "creatures", "variants"],
  "properties": {
    "schema_version": {"const": "0.18.2"},
    "manifest_type": {"const": "creatures-monsters-runtime-qa-integrity"},
    "production_registry": {"type": "boolean"},
    "registry_authority": {"type": "string"},
    "production_routing": {"const": "BLOCKED"},
    "canonical_directions": {"const": ["south", "south_east", "east", "north_east", "north", "north_west", "west", "south_west"]},
    "canonical_animation_states": {"const": ["idle", "locomotion", "attack_primary", "hit_reaction", "death"]},
    "creatures": {"type": "array", "minItems": 6, "items": {"type": "object", "additionalProperties": true}},
    "variants": {"type": "array", "minItems": 8, "items": {"type": "object", "required": ["variant_id", "variant_revision", "creature_id", "kind", "parent_id", "inherits", "overrides", "override_values"], "additionalProperties": true}}
  }
}
