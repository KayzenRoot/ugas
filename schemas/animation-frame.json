{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ugas.local/schemas/animation-frame.json",
  "title": "UGAS animation frame v0.5.1",
  "type": "object",
  "required": ["frame_name", "path", "sha256", "alpha_bbox_before", "translation", "scale", "pivot_policy", "ground_baseline", "guide_sha256", "normalization_status"],
  "properties": {"frame_name": {"type": "string"}, "path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "scale": {"const": 1.0}, "ground_baseline": {"const": 478}, "normalization_status": {"const": "TRANSLATED_NO_STRETCH"}}
}
