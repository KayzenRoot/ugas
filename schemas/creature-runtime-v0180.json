{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UGAS v0.18.0 creature and monster runtime foundation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_type", "production_registry", "registry_authority", "canonical_directions", "canonical_animation_states", "creatures", "variants"],
  "properties": {
    "schema_version": {"const": "0.18.0"},
    "manifest_type": {"const": "creatures-monsters-runtime-foundation"},
    "production_registry": {"type": "boolean"},
    "registry_authority": {"type": "string", "minLength": 1},
    "canonical_directions": {"const": ["south", "south_east", "east", "north_east", "north", "north_west", "west", "south_west"]},
    "canonical_animation_states": {"const": ["idle", "locomotion", "attack_primary", "hit_reaction", "death"]},
    "creatures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["creature_id", "species_id", "archetype", "topology_id", "locomotion_class", "support_model", "rig_family", "base_scale", "footprint", "collision_profile", "anchors", "direction_coverage", "animation_state_contract", "variant_lineage", "asset_revision", "provenance", "provenance_hash", "test_only", "production_safe", "fixture"],
        "properties": {
          "creature_id": {"type": "string", "pattern": "^[a-z0-9_\\-]+$"},
          "species_id": {"type": "string", "minLength": 1},
          "archetype": {"enum": ["humanoid_biped", "quadruped", "flying_winged", "serpentine", "amorphous", "stationary_structure"]},
          "topology_id": {"type": "string", "minLength": 1},
          "locomotion_class": {"type": "string", "minLength": 1},
          "support_model": {"type": "string", "minLength": 1},
          "rig_family": {"type": "string", "minLength": 1},
          "base_scale": {"type": "object", "required": ["x", "y"], "properties": {"x": {"type": "number", "exclusiveMinimum": 0}, "y": {"type": "number", "exclusiveMinimum": 0}}},
          "footprint": {"type": "object", "required": ["width", "depth"], "properties": {"width": {"type": "number", "exclusiveMinimum": 0}, "depth": {"type": "number", "exclusiveMinimum": 0}}},
          "collision_profile": {"type": "object", "required": ["shape", "width", "height", "pivot", "bounds"], "properties": {"shape": {"type": "string"}, "width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}, "pivot": {"type": "object"}, "bounds": {"type": "object"}}},
          "anchors": {"type": "object", "minProperties": 1},
          "direction_coverage": {"type": "array", "items": {"enum": ["south", "south_east", "east", "north_east", "north", "north_west", "west", "south_west"]}},
          "animation_state_contract": {"type": "object", "required": ["idle", "locomotion", "attack_primary", "hit_reaction", "death"], "additionalProperties": false, "properties": {"idle": {"enum": ["REQUIRED", "OPTIONAL", "UNSUPPORTED"]}, "locomotion": {"enum": ["REQUIRED", "OPTIONAL", "UNSUPPORTED"]}, "attack_primary": {"enum": ["REQUIRED", "OPTIONAL", "UNSUPPORTED"]}, "hit_reaction": {"enum": ["REQUIRED", "OPTIONAL", "UNSUPPORTED"]}, "death": {"enum": ["REQUIRED", "OPTIONAL", "UNSUPPORTED"]}}},
          "variant_lineage": {"type": "object", "required": ["variant_id", "kind", "parent_id", "inherits", "overrides"], "properties": {"variant_id": {"type": "string"}, "kind": {"enum": ["base", "derived"]}, "parent_id": {}, "inherits": {"type": "array"}, "overrides": {"type": "array"}}},
          "asset_revision": {"type": "string", "minLength": 1},
          "provenance": {"type": "object", "required": ["source_kind", "source_id", "source_revision", "record_hash", "production_safe"], "properties": {"source_kind": {"const": "TEST_ONLY_SYNTHETIC"}, "source_id": {"type": "string"}, "source_revision": {"type": "string"}, "record_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "production_safe": {"const": false}}},
          "provenance_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "test_only": {"const": true},
          "production_safe": {"const": false}
          ,"fixture": {"type": "object", "required": ["color_rgba", "orientation_marker", "fixture_index"], "properties": {"color_rgba": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer", "minimum": 0, "maximum": 255}}, "orientation_marker": {"type": "string", "minLength": 1}, "fixture_index": {"type": "integer", "minimum": 1}}}
        }
      }
    },
    "variants": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["variant_id", "creature_id", "kind", "parent_id", "inherits", "overrides"], "properties": {"variant_id": {"type": "string"}, "creature_id": {"type": "string"}, "kind": {"enum": ["base", "derived"]}, "parent_id": {}, "inherits": {"type": "array"}, "overrides": {"type": "array"}}}}
  }
}
