{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UGAS active v0.5.2 state",
  "type": "object",
  "required": ["schema_version", "version", "phase", "previous_release", "current_gate", "stop_reason", "canonical_anchor", "allowed_next_actions", "forbidden_actions"],
  "properties": {
    "schema_version": {"const": "0.5.2"},
    "version": {"const": "0.5.2"},
    "phase": {"const": "POSE_CONTROL_ESCALATION"},
    "current_gate": {"type": "string", "minLength": 1},
    "stop_reason": {"type": ["string", "null"]},
    "previous_release": {
      "type": "object",
      "required": ["version", "status", "anchors_passed", "walk_passed"],
      "properties": {
        "version": {"const": "0.5.1"},
        "status": {"const": "MULTI_REFERENCE_POSE_CONTROL_GAP"},
        "anchors_passed": {"const": false},
        "walk_passed": {"const": false}
      }
    },
    "canonical_anchor": {
      "type": "object",
      "required": ["asset_id", "revision_id", "sha256"],
      "properties": {"asset_id": {"type": "string"}, "revision_id": {"type": "string"}, "sha256": {"pattern": "^[0-9a-fA-F]{64}$"}}
    },
    "allowed_next_actions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "forbidden_actions": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
