{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UGAS active v0.5.5 review snapshot integrity state",
  "type": "object",
  "required": ["schema_version", "version", "phase", "previous_release", "current_gate", "stop_reason", "canonical_anchor", "allowed_next_actions", "forbidden_actions", "generation_provider_change_authorized", "walk_authorized", "pose_lane_status", "review_snapshot_status", "state_consistency"],
  "properties": {
    "schema_version": {"const": "0.5.5"},
    "version": {"const": "0.5.5"},
    "phase": {"const": "REVIEW_SNAPSHOT_INTEGRITY"},
    "current_gate": {"const": "REVIEW_SNAPSHOT_INTEGRITY_FIXED"},
    "stop_reason": {"type": ["string", "null"]},
    "generation_provider_change_authorized": {"const": false},
    "walk_authorized": {"const": false},
    "previous_release": {
      "type": "object",
      "required": ["version", "reported_status"],
      "properties": {
        "version": {"const": "0.5.4"},
        "reported_status": {"const": "LOCAL_POSE_CONTROL_PROVIDER_GAP_CONFIRMED"}
      }
    },
    "pose_lane_status": {"const": "LOCAL_POSE_CONTROL_PROVIDER_GAP_CONFIRMED"},
    "review_snapshot_status": {"const": "REVIEW_ARCHIVE_VERIFIED"},
    "canonical_anchor": {
      "type": "object",
      "required": ["asset_id", "revision_id", "sha256"],
      "properties": {"asset_id": {"type": "string"}, "revision_id": {"type": "string"}, "sha256": {"pattern": "^[0-9a-fA-F]{64}$"}}
    },
    "allowed_next_actions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "forbidden_actions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "state_consistency": {
      "type": "object",
      "required": ["status", "contradictory_walk_or_anchor_promotion", "new_generation_started", "new_generation_jobs"],
      "properties": {
        "status": {"type": "string", "minLength": 1},
        "contradictory_walk_or_anchor_promotion": {"const": false},
        "new_generation_started": {"const": false},
        "new_generation_jobs": {"const": 0}
      }
    }
  }
}
