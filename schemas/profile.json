{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ugas.dev/schema/profile.json",
  "title": "UGAS profile",
  "type": "object",
  "required": ["id", "name", "dimension", "description", "use_cases", "artistic_parameters", "technical_parameters", "asset_structure", "budgets", "provider_guidance", "naming", "animation", "limitations"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "name": {"type": "string", "minLength": 1},
    "dimension": {"enum": ["2d", "3d"]},
    "description": {"type": "string"},
    "use_cases": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "artistic_parameters": {"type": "object"},
    "technical_parameters": {"type": "object"},
    "asset_structure": {"type": "object"},
    "budgets": {"type": "object"},
    "provider_guidance": {"type": "array", "items": {"type": "string"}},
    "naming": {"type": "object"},
    "animation": {"type": "object"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
