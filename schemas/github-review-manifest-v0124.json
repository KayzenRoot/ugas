{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UGAS v0.12.4 GitHub CI governance review manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_type", "repository", "pull_request", "scope", "changed_files", "change_statistics", "current_state", "incident", "tests", "validation", "overall_status", "gates", "review_index", "visual_manifest", "known_gaps", "gap_context", "dashboard_policy", "production_boundary", "security_boundary"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "manifest_type": {"const": "github-ci-governance-review"},
    "repository": {"type": "object", "required": ["name", "url", "default_branch"], "properties": {"name": {"const": "csn1985-ship-it/ugas"}, "url": {"const": "https://github.com/csn1985-ship-it/ugas"}, "default_branch": {"const": "main"}}},
    "pull_request": {"type": "object", "required": ["number", "base_sha", "head_sha", "merge_base_sha", "head_branch", "base_branch"], "properties": {"number": {"type": "integer", "minimum": 0}, "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "merge_base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "head_branch": {"type": "string", "minLength": 1}, "base_branch": {"const": "main"}}},
    "scope": {"type": "object", "required": ["version", "phase", "current_gate", "allowed_next_actions", "new_generation"], "properties": {"version": {"const": "0.12.4"}, "phase": {"const": "GITHUB_CI_GOVERNANCE_RECOVERY"}, "current_gate": {"enum": ["GITHUB_CI_GOVERNANCE_RECOVERY_READY_FOR_PR", "GITHUB_CI_GOVERNANCE_RECOVERY_TECHNICALLY_QUALIFIED"]}, "allowed_next_actions": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "new_generation": {"const": 0}}},
    "changed_files": {"type": "array", "items": {"type": "object", "required": ["path", "status"], "properties": {"path": {"type": "string", "minLength": 1}, "status": {"enum": ["A", "M", "D", "R"]}, "additions": {"type": "integer", "minimum": 0}, "deletions": {"type": "integer", "minimum": 0}}}},
    "change_statistics": {"type": "object", "required": ["files", "additions", "deletions"], "properties": {"files": {"type": "integer", "minimum": 0}, "additions": {"type": "integer", "minimum": 0}, "deletions": {"type": "integer", "minimum": 0}}},
    "current_state": {"type": "object", "required": ["path", "version", "phase", "current_gate", "production_approved", "production_routing", "external_visual_review", "allowed_next_actions"], "properties": {"path": {"const": "docs/evidence/current-state.json"}, "version": {"const": "0.12.4"}, "phase": {"const": "GITHUB_CI_GOVERNANCE_RECOVERY"}, "current_gate": {"enum": ["GITHUB_CI_GOVERNANCE_RECOVERY_READY_FOR_PR", "GITHUB_CI_GOVERNANCE_RECOVERY_TECHNICALLY_QUALIFIED"]}, "production_approved": {"const": false}, "production_routing": {"const": "BLOCKED"}, "external_visual_review": {"type": "object"}, "allowed_next_actions": {"type": "array", "minItems": 1}}},
    "incident": {"type": "object", "required": ["pr_number", "classification", "artifact_id", "artifact_digest"], "properties": {"pr_number": {"const": 1}, "classification": {"const": "GOVERNANCE_ORDER_VIOLATION_AND_FAILED_CHECK_MERGE"}, "artifact_id": {"const": "9867524286"}, "artifact_digest": {"const": "sha256:6ffe21738ed7960aabb5cd874cc44c4030a3b5fee0463f58c004805637a4d6d2"}}},
    "tests": {"type": "object"},
    "validation": {"type": "object"},
    "overall_status": {"enum": ["PASS", "FAIL"]},
    "gates": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "status", "exit_code", "detail"], "properties": {"id": {"type": "string", "minLength": 1}, "status": {"enum": ["PASS", "FAIL", "NOT_RUN"]}, "exit_code": {"type": ["integer", "null"]}, "detail": {"type": "string"}}}},
    "review_index": {"type": "object", "required": ["historical_path", "historical_version", "status", "active_manifest_path"], "properties": {"historical_path": {"const": "docs/evidence/review-index-v0.12.2.json"}, "historical_version": {"const": "0.12.2"}, "status": {"enum": ["PRESERVED_BASELINE_VALIDATED", "PRESERVED_BASELINE_REHEARSAL"]}, "active_manifest_path": {"const": "github-review-manifest.json"}}},
    "visual_manifest": {"const": "visual-manifest.json"},
    "known_gaps": {"type": "array", "items": {"type": "string"}},
    "gap_context": {"type": "object", "required": ["source", "pr_number", "pr_available", "explicit_gap_input"], "properties": {"source": {"enum": ["github_event", "local_rehearsal"]}, "pr_number": {"type": "integer", "minimum": 0}, "pr_available": {"type": "boolean"}, "explicit_gap_input": {"type": "boolean"}}},
    "dashboard_policy": {"type": "object", "required": ["always_on", "runtime_mode", "local_only", "url", "must_remain_online_at_stop"], "properties": {"always_on": {"const": true}, "runtime_mode": {"const": "DOCKER_ALWAYS_ON_LOCAL"}, "local_only": {"const": true}, "url": {"const": "http://127.0.0.1:8765/"}, "must_remain_online_at_stop": {"const": true}}},
    "production_boundary": {"type": "object", "properties": {"approved": {"const": false}, "routing": {"const": "BLOCKED"}}},
    "security_boundary": {"type": "object", "properties": {"secrets_included": {"const": false}, "model_weights_included": {"const": false}, "telemetry_db_included": {"const": false}, "local_credentials_included": {"const": false}}}
  }
}
