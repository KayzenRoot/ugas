{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UGAS items and props runtime foundation v0.19.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_type", "production_registry", "registry_authority", "production_routing", "canonical_classes", "contexts", "items", "variants"],
  "properties": {
    "schema_version": {"const": "0.19.0"},
    "manifest_type": {"const": "items-props-runtime-foundation"},
    "production_registry": {"type": "boolean"},
    "registry_authority": {"type": "string"},
    "production_routing": {"const": "BLOCKED"},
    "canonical_classes": {"type": "array", "const": ["weapon_item", "consumable_item", "material_item", "quest_key_item", "container_prop", "environmental_prop"]},
    "contexts": {"type": "array", "const": ["inventory", "world", "equipment-preview"]},
    "items": {"type": "array", "minItems": 0, "items": {"type": "object", "required": ["item_or_prop_id", "class_id", "representation_profile", "representations", "world_geometry", "stack_policy", "display_variant_id", "equipment_ref", "variant_lineage", "provenance", "provenance_hash", "test_only", "production_safe"]}},
    "variants": {"type": "array", "items": {"type": "object", "required": ["variant_id", "item_or_prop_id", "kind", "parent_id", "variant_revision", "overrides", "override_values"]}}
  }
}
