    "schema_version": {"type": "string"}, "set_id": {"type": "string"}, "asset_id": {"type": "string"}, "spec_sha256": {"type": "string"}, "compiled_prompt_sha256": {"type": "string"}, "candidate_count": {"type": "integer", "minimum": 1}, "candidates": {"type": "array", "items": {"type": "object"}}, "best_technical_candidate": {"type": ["string", "null"]}, "visual_approval": {"enum": ["pending", "approved"]}, "contact_sheet": {"type": "object"}
  }
}
