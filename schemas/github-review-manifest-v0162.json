{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UGAS v0.16.2 direction runtime cache/state GitHub review manifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "manifest_type", "repository", "pull_request", "scope", "changed_files", "change_statistics", "current_state", "tests", "validation", "overall_status", "gates", "historical_release", "correction_history", "visual_manifest", "direction_runtime_evidence", "front_compatibility_evidence", "known_gaps", "gap_context", "production_boundary", "security_boundary"],
  "properties": {
    "schema_version": {"const": "1.5"},
    "manifest_type": {"const": "github-ci-capability-review"},
    "repository": {"type": "object", "required": ["name", "url", "default_branch"], "properties": {"name": {"const": "KayzenRoot/ugas"}, "url": {"const": "https://github.com/KayzenRoot/ugas"}, "default_branch": {"const": "main"}}},
    "pull_request": {"type": "object", "required": ["number", "base_sha", "head_sha", "merge_base_sha", "head_branch", "base_branch"], "properties": {"number": {"const": 6}, "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "merge_base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "head_branch": {"const": "codex/v0.16.0-multi-direction-runtime-foundation"}, "base_branch": {"const": "main"}}},
    "scope": {"type": "object", "required": ["version", "phase", "current_gate", "allowed_next_actions", "new_generation"], "properties": {"version": {"const": "0.16.2"}, "phase": {"const": "MULTI_DIRECTION_ANIMATION_RUNTIME"}, "current_gate": {"const": "MULTI_DIRECTION_ANIMATION_RUNTIME_CACHE_AND_STATE_INTEGRITY_TECHNICALLY_QUALIFIED"}, "allowed_next_actions": {"const": ["governed_merge_pr_6"]}, "new_generation": {"const": 0}}},
    "changed_files": {"type": "array", "items": {"type": "object", "required": ["path", "status"], "properties": {"path": {"type": "string", "minLength": 1}, "status": {"enum": ["A", "M", "D", "R"]}, "additions": {"type": "integer", "minimum": 0}, "deletions": {"type": "integer", "minimum": 0}}}},
    "change_statistics": {"type": "object", "required": ["files", "additions", "deletions"], "properties": {"files": {"type": "integer", "minimum": 0}, "additions": {"type": "integer", "minimum": 0}, "deletions": {"type": "integer", "minimum": 0}}},
    "current_state": {"type": "object", "required": ["path", "version", "phase", "current_gate", "production_approved", "production_routing", "external_visual_review", "allowed_next_actions", "review"], "properties": {"path": {"const": "docs/evidence/current-state.json"}, "version": {"const": "0.16.2"}, "phase": {"const": "MULTI_DIRECTION_ANIMATION_RUNTIME"}, "current_gate": {"const": "MULTI_DIRECTION_ANIMATION_RUNTIME_CACHE_AND_STATE_INTEGRITY_TECHNICALLY_QUALIFIED"}, "production_approved": {"const": false}, "production_routing": {"const": "BLOCKED"}, "external_visual_review": {"type": "object"}, "allowed_next_actions": {"const": ["governed_merge_pr_6"]}, "review": {"type": "object"}}},
    "tests": {"type": "object"},
    "validation": {"type": "object"},
    "overall_status": {"enum": ["PASS", "FAIL"]},
    "gates": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "status", "exit_code", "detail"], "properties": {"id": {"type": "string", "minLength": 1}, "status": {"enum": ["PASS", "FAIL", "NOT_RUN"]}, "exit_code": {"type": ["integer", "null"]}, "detail": {"type": "string"}}}},
    "historical_release": {"type": "object", "required": ["version", "merge_commit", "approved_head", "rejected_v0150_preserved"], "properties": {"version": {"const": "0.15.1"}, "merge_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "approved_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "rejected_v0150_preserved": {"const": true}}},
    "correction_history": {"type": "object", "required": ["version", "status", "rejected_head", "record", "previous_rejected_attempt"], "properties": {"version": {"const": "0.16.1"}, "status": {"const": "CORRECTION_REQUIRED"}, "rejected_head": {"const": "2513d9f6f8a55345e74d9c0afb5dab22f9d84705"}, "record": {"type": "string"}, "previous_rejected_attempt": {"type": "object", "required": ["version", "status", "rejected_head", "record"], "properties": {"version": {"const": "0.16.0"}, "status": {"const": "CORRECTION_REQUIRED"}, "rejected_head": {"const": "7d1e999e91ee8817c6754b363a5c19f1ba6f2e7d"}, "record": {"type": "string"}}}}},
    "visual_manifest": {"const": "visual-manifest.json"},
    "direction_runtime_evidence": {"type": "object", "required": ["contract", "coverage_manifest", "validation", "negative_controls", "cache_unresolved_class_qa", "cache_order_negative_controls", "test_only_cache_mode_qa", "invalid_vector_qa", "test_only_production_safety_qa", "state_consistency", "fixture_manifest", "contact_sheet", "fallback_qa", "mirror_qa", "provenance_qa"], "properties": {"contract": {"type": "string"}, "coverage_manifest": {"type": "string"}, "validation": {"type": "string"}, "negative_controls": {"type": "string"}, "cache_unresolved_class_qa": {"type": "string"}, "cache_order_negative_controls": {"type": "string"}, "test_only_cache_mode_qa": {"type": "string"}, "invalid_vector_qa": {"type": "string"}, "test_only_production_safety_qa": {"type": "string"}, "state_consistency": {"type": "string"}, "fixture_manifest": {"type": "string"}, "contact_sheet": {"type": "string"}, "fallback_qa": {"type": "string"}, "mirror_qa": {"type": "string"}, "provenance_qa": {"type": "string"}}},
    "front_compatibility_evidence": {"type": "object", "required": ["runtime_log", "runtime_exit_code"], "properties": {"runtime_log": {"type": "string"}, "runtime_exit_code": {"type": "integer"}}},
    "known_gaps": {"type": "array", "items": {"type": "string"}},
    "gap_context": {"type": "object", "required": ["source", "pr_number", "pr_available", "explicit_gap_input"], "properties": {"source": {"enum": ["github_event", "local_rehearsal"]}, "pr_number": {"type": "integer", "minimum": 0}, "pr_available": {"type": "boolean"}, "explicit_gap_input": {"type": "boolean"}}},
    "production_boundary": {"type": "object", "required": ["approved", "routing"], "properties": {"approved": {"const": false}, "routing": {"const": "BLOCKED"}}},
    "security_boundary": {"type": "object", "required": ["secrets_included", "model_weights_included", "telemetry_db_included", "local_credentials_included"], "properties": {"secrets_included": {"const": false}, "model_weights_included": {"const": false}, "telemetry_db_included": {"const": false}, "local_credentials_included": {"const": false}}}
  }
}
