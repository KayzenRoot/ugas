{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ugas.local/schemas/pose-guide.json",
  "title": "UGAS deterministic pose guide v0.5.0",
  "type": "object",
  "required": ["schema_version", "guide_type", "guide_id", "canvas", "baseline_y", "centerline_x", "keypoints", "ground_policy", "pivot_policy", "source_controlled", "generated_ai_content", "deterministic"],
  "properties": {"schema_version": {"const": "0.5.0"}, "guide_type": {"enum": ["view", "walk"]}, "canvas": {"type": "object", "required": ["width", "height"]}, "baseline_y": {"const": 478}, "centerline_x": {"const": 256}, "keypoints": {"type": "object", "minProperties": 6}, "source_controlled": {"const": true}, "generated_ai_content": {"const": false}, "deterministic": {"const": true}}
}
