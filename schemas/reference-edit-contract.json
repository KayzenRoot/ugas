{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ugas.local/schemas/reference-edit-contract.json",
  "title": "UGAS Reference Edit Contract",
  "type": "object",
  "required": [
    "schema_version", "asset_id", "source_revision_id", "source_sha256", "edit_type",
    "requested_change", "target_property", "allowed_changes", "protected_properties",
    "protected_regions", "preserve_identity", "preserve_pose", "preserve_camera",
    "preserve_silhouette", "preserve_exposure", "preserve_skin_face", "target_mask_policy",
    "protected_mask_policy", "thresholds", "candidate_count", "seeds", "preferred_route"
  ],
  "properties": {
    "schema_version": {"const": "0.4.3"},
    "asset_id": {"type": "string", "minLength": 1},
    "source_revision_id": {"type": "string", "minLength": 1},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "edit_type": {"const": "reference-edit-color-only"},
    "requested_change": {"type": "string", "minLength": 1},
    "target_property": {"type": "string", "minLength": 1},
    "allowed_changes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "protected_properties": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "protected_regions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "preserve_identity": {"const": true},
    "preserve_pose": {"const": true},
    "preserve_camera": {"const": true},
    "preserve_silhouette": {"const": true},
    "preserve_exposure": {"const": true},
    "preserve_skin_face": {"const": true},
    "target_mask_policy": {"type": "object"},
    "protected_mask_policy": {"type": "object"},
    "thresholds": {"type": "object", "minProperties": 1},
    "candidate_count": {"type": "integer", "minimum": 1, "maximum": 6},
    "seeds": {"type": "array", "items": {"type": "integer"}},
    "preferred_route": {"type": "string", "minLength": 1},
    "human_review_required": {"const": true}
  },
  "additionalProperties": true
}
