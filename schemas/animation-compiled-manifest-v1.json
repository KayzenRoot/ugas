{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ugas.local/schemas/animation-compiled-manifest-v1.json",
  "title": "UGAS compiled animation manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "animation_id", "spec_path", "spec_sha256", "source", "frames", "compile_status", "runtime_adapter", "determinism"],
  "properties": {
    "schema_version": {"const": "animation-compiled-manifest-1.0"},
    "animation_id": {"type": "string", "minLength": 1},
    "spec_path": {"type": "string", "minLength": 1},
    "spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {"type": "object", "additionalProperties": false, "required": ["asset_revision_id", "direction", "source_sha256", "source_rig_ref"], "properties": {"asset_revision_id": {"type": "string"}, "direction": {"type": "string"}, "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "source_rig_ref": {"type": "string"}}},
    "frames": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["index", "phase", "path", "rgba_sha256", "target_hash"], "properties": {"index": {"type": "integer", "minimum": 0}, "phase": {"type": "string"}, "path": {"type": "string"}, "rgba_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "target_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "metadata": {"type": "object"}}}},
    "compile_status": {"const": "COMPILED"},
    "runtime_adapter": {"type": "string", "minLength": 1},
    "determinism": {"type": "object", "additionalProperties": false, "required": ["pixel_operation", "parameters_frozen_before_render", "source_only_pixels", "replay_rule"], "properties": {"pixel_operation": {"type": "string"}, "parameters_frozen_before_render": {"type": "boolean"}, "source_only_pixels": {"type": "boolean"}, "replay_rule": {"type": "string"}}}
  }
}
