{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UGAS v0.18.0 bounded GitHub review manifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "manifest_type", "repository", "pull_request", "scope", "changed_files", "change_statistics", "current_state", "tests", "validation", "overall_status", "gates", "creatures_monsters_evidence", "production_boundary", "security_boundary"],
  "properties": {
    "schema_version": {"const": "0.18.0"},
    "manifest_type": {"const": "github-ci-creatures-monsters-review"},
    "pull_request": {"type": "object", "additionalProperties": true, "required": ["number", "base_sha", "head_sha", "merge_base_sha", "head_branch", "base_branch"]},
    "scope": {"type": "object", "additionalProperties": true, "required": ["version", "phase", "current_gate", "allowed_next_actions", "new_generation"]},
    "changed_files": {"type": "array"},
    "change_statistics": {"type": "object"},
    "current_state": {"type": "object"},
    "tests": {"type": "object"},
    "validation": {"type": "object"},
    "overall_status": {"type": "string"},
    "gates": {"type": "array"},
    "creatures_monsters_evidence": {"type": "object"},
    "production_boundary": {"type": "object"},
    "security_boundary": {"type": "object"}
  }
}
