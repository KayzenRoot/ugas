{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ugas.local/schemas/animation-qa-result-v1.json",
  "title": "UGAS animation QA result v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "animation_id", "decision", "status", "spec_sha256", "compiled_manifest_sha256", "frames", "temporal", "provenance", "hard_gates", "failures"],
  "properties": {
    "schema_version": {"const": "animation-qa-result-1.1"},
    "animation_id": {"type": "string"},
    "decision": {"enum": ["QUALIFIED", "FAILED"]},
    "status": {"type": "string", "minLength": 1},
    "spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "compiled_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "frames": {"type": "array", "items": {"type": "object"}},
    "temporal": {"type": "object"},
    "provenance": {"type": "object"},
    "hard_gates": {"type": "object"},
    "negative_control": {"type": "object"},
    "failures": {"type": "array", "items": {"type": "string"}},
    "structural": {"type": "object"}
  }
}
