{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UGAS v0.20.0 environment tileset runtime foundation",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "manifest_type", "tileset_id", "tileset_revision", "classes", "metrics", "layer_order", "layers", "terrain_families", "tiles", "variants", "production_approved", "production_routing", "production_registry_empty", "test_only", "production_safe", "prop_sockets", "provenance"],
  "properties": {
    "schema_version": {"const": "0.20.0"},
    "manifest_type": {"const": "environment-tileset-runtime-foundation"},
    "tileset_id": {"type": "string", "minLength": 1},
    "tileset_revision": {"type": "string", "minLength": 1},
    "classes": {"type": "array", "minItems": 6},
    "metrics": {"type": "object", "required": ["tile_width", "tile_height", "atlas_width", "atlas_height", "origin", "grid_orientation"]},
    "layer_order": {"type": "array", "minItems": 6},
    "layers": {"type": "array", "minItems": 6},
    "terrain_families": {"type": "array", "minItems": 2},
    "tiles": {"type": "array", "minItems": 12},
    "variants": {"type": "array", "minItems": 1},
    "production_approved": {"const": false},
    "production_routing": {"const": "BLOCKED"},
    "production_registry_empty": {"const": true},
    "test_only": {"const": true},
    "production_safe": {"const": false},
    "prop_sockets": {"type": "array"},
    "provenance": {"type": "object", "required": ["manifest_hash"]}
  }
}
