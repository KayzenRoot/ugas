{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UGAS v0.17.1 equipment and outfits runtime manifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "manifest_type", "production_registry", "rig_revision", "rig_manifest", "layer_order", "layer_dependencies", "replacement_conflict_policy", "mirror_policy", "assets"],
  "properties": {
    "schema_version": {"const": "0.17.1"},
    "manifest_type": {"const": "equipment-outfits-runtime"},
    "production_registry": {"type": "boolean"},
    "rig_revision": {"const": "r4-cutout-rig-v071"},
    "rig_manifest": {"type": "string", "minLength": 1},
    "layer_order": {"type": "array", "minItems": 13, "items": {"type": "string"}},
    "layer_dependencies": {"type": "object", "additionalProperties": true},
    "replacement_conflict_policy": {"const": "highest_priority_then_equipment_id"},
    "mirror_policy": {"const": "manifest-permission-only"},
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["equipment_id", "slot", "variant", "layer_group", "priority", "anchors", "direction_coverage", "animation_compatibility", "rig_revision_compatibility", "replacement_rules", "occlusion_masks", "provenance_hash", "asset_revision", "test_only", "production_safe", "mirror_safe", "asymmetry_flags"],
        "properties": {
          "occlusion_masks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["mask_id", "target_part", "binding", "policy", "geometry", "mask_hash"],
              "properties": {
                "binding": {"const": "asset-bound"},
                "policy": {"const": "explicit-layer-alpha"},
                "geometry": {
                  "type": "object",
                  "required": ["type", "x", "y", "width", "height"],
                  "properties": {
                    "type": {"const": "rectangle"},
                    "x": {"type": "integer"}, "y": {"type": "integer"},
                    "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}
                  }
                },
                "mask_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          }
        }
      }
    }
  }
}
