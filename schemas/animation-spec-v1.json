{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ugas.local/schemas/animation-spec-v1.json",
  "title": "UGAS Animation Specification v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "animation_id", "asset_revision_id", "direction", "frame_count", "loop", "source_rig_ref", "key_pose_bindings", "interpolation_profile", "root_motion_profile", "foot_policy", "z_order_profile", "presentation_transform", "qa_profile", "package_profile", "provenance", "forbidden_operations", "runtime_adapter"],
  "oneOf": [
    {"required": ["fps"], "not": {"required": ["per_frame_duration_ms"]}},
    {"required": ["per_frame_duration_ms"], "not": {"required": ["fps"]}}
  ],
  "properties": {
    "schema_version": {"const": "animation-spec-1.0"},
    "animation_id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "asset_revision_id": {"type": "string", "minLength": 1},
    "direction": {"type": "string", "minLength": 1},
    "frame_count": {"type": "integer", "minimum": 2, "maximum": 64},
    "fps": {"type": "number", "exclusiveMinimum": 0},
    "per_frame_duration_ms": {"type": "number", "exclusiveMinimum": 0},
    "loop": {"type": "boolean"},
    "event_markers": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["event_id", "frame", "kind"], "properties": {"event_id": {"type": "string", "minLength": 1}, "frame": {"type": "integer", "minimum": 0}, "kind": {"type": "string", "minLength": 1}, "payload": {"type": "object"}}}},
    "source_rig_ref": {"type": "string", "minLength": 1},
    "key_pose_bindings": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["frame", "phase", "target_hash"], "properties": {"frame": {"type": "integer", "minimum": 0}, "phase": {"type": "string", "minLength": 1}, "target_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "interpolation_profile": {"type": "object", "additionalProperties": false, "required": ["method", "parameters_frozen_before_render"], "properties": {"method": {"type": "string", "minLength": 1}, "parameters_frozen_before_render": {"type": "boolean"}, "parameters": {"type": "object"}}},
    "root_motion_profile": {"type": "object", "additionalProperties": false, "required": ["method"], "properties": {"method": {"type": "string", "minLength": 1}, "limits": {"type": "object"}}},
    "foot_policy": {"type": "object", "additionalProperties": false, "required": ["method", "both_feet_required"], "properties": {"method": {"type": "string", "minLength": 1}, "both_feet_required": {"type": "boolean"}, "limits": {"type": "object"}}},
    "z_order_profile": {"type": "object", "additionalProperties": false, "required": ["method", "switches_allowed"], "properties": {"method": {"type": "string", "minLength": 1}, "switches_allowed": {"type": "boolean"}, "plan_ref": {"type": "string"}, "constant_order": {"type": "array", "items": {"type": "string"}}}},
    "presentation_transform": {"type": "object", "additionalProperties": false, "required": ["method", "uniform_scale", "anchor", "translation", "frozen_before_render"], "properties": {"method": {"type": "string", "minLength": 1}, "uniform_scale": {"type": "number", "exclusiveMinimum": 0}, "anchor": {"type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": {"x": {"type": "number"}, "y": {"type": "number"}}}, "translation": {"type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": {"x": {"type": "number"}, "y": {"type": "number"}}}, "frozen_before_render": {"type": "boolean"}}},
    "qa_profile": {"type": "object", "additionalProperties": false, "required": ["profile_id", "feature_flags", "thresholds"], "properties": {"profile_id": {"type": "string", "minLength": 1}, "feature_flags": {"type": "object"}, "thresholds": {"type": "object"}}},
    "package_profile": {"type": "object", "additionalProperties": false, "required": ["cell_size", "columns", "rows", "format", "gif_review_only"], "properties": {"cell_size": {"type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": {"width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}}, "columns": {"type": "integer", "minimum": 1}, "rows": {"type": "integer", "minimum": 1}, "format": {"const": "RGBA"}, "gif_review_only": {"type": "boolean"}, "sprite_name": {"type": "string", "minLength": 1}, "gif_name": {"type": "string", "minLength": 1}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["source_image", "source_parts_dir", "source_masks_dir", "source_skeleton", "source_sha256", "sam2_used", "comfyui_generation_jobs", "diffusion_used", "source_only_pixels"], "properties": {"source_image": {"type": "string", "minLength": 1}, "source_parts_dir": {"type": "string", "minLength": 1}, "source_masks_dir": {"type": "string", "minLength": 1}, "source_skeleton": {"type": "string", "minLength": 1}, "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "sam2_used": {"type": "boolean"}, "comfyui_generation_jobs": {"type": "integer", "minimum": 0}, "diffusion_used": {"type": "boolean"}, "source_only_pixels": {"type": "boolean"}, "source_manifests": {"type": "array", "items": {"type": "string"}}}},
    "forbidden_operations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "runtime_adapter": {"type": "string", "minLength": 1, "pattern": "^[a-zA-Z0-9_.]+$"},
    "adapter_parameters": {"type": "object"}
  }
}
