{
  "schema_version": "0.2",
  "id": "provider-huggingface",
  "kind": "remote-model-provider",
  "priority": "fallback",
  "endpoint": "https://huggingface.co",
  "capabilities": ["2d", "model-metadata", "remote-inference-when-enabled"],
  "availability_contract": {"requires_network": true, "requires_model_and_license_review": true, "quota_must_be_known": true},
  "credential_policy": "Tokens are supplied out of band by the consumer and are never committed.",
  "limitations": ["V0.2 does not download models or invoke hosted inference"]
}
